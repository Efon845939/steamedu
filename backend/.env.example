# Copy to backend/.env for local runs. In production set these in the host dashboard instead.
# Never commit real values.
MONGO_URL=mongodb://localhost:27017
DB_NAME=steamedu
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
# Code teachers type at signup. Pick your own; share it only with teachers you invite.
TEACHER_SIGNUP_CODE=change-me
# Comma-separated origins allowed by CORS. Leave unset when frontend and API share one domain.
# CORS_ORIGINS=https://your-app.vercel.app
# true only on a throwaway demo database: creates demo users with publicly known passwords.
SEED_DEMO_ACCOUNTS=false
